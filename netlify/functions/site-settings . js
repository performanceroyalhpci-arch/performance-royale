// netlify/functions/site-settings.js
//
// Gère les paramètres globaux du site dans Firestore
// GET /.netlify/functions/site-settings → récupérer tous les paramètres
// PUT /.netlify/functions/site-settings → mettre à jour les paramètres

const FIRESTORE_PROJECT_ID = process.env.FIREBASE_PROJECT_ID;
const FIRESTORE_API_KEY = process.env.FIREBASE_API_KEY;
const FIRESTORE_BASE_URL = `https://firestore.googleapis.com/v1/projects/${FIRESTORE_PROJECT_ID}/databases/(default)/documents`;

// Valeurs par défaut
const DEFAULT_SETTINGS = {
  siteName: 'Performance Royale',
  whatsappNumber: '+225XXXXXXXXXX',
  whatsappMessage: 'Bonjour, j\'aimerais en savoir plus sur vos produits.',
  primaryColor: '#10b981',
  accentColor: '#ef4444',
  footerText: '© 2024 Performance Royale. Tous droits réservés.',
  heroTitle: 'Performance Royale',
  heroSubtitle: 'Bien-être masculin à votre portée'
};

async function getSettings() {
  try {
    const response = await fetch(
      `${FIRESTORE_BASE_URL}/site-settings/main?key=${FIRESTORE_API_KEY}`,
      { method: 'GET' }
    );

    if (!response.ok) {
      return DEFAULT_SETTINGS;
    }

    const data = await response.json();
    const fields = data.fields || {};

    return {
      siteName: fields.siteName?.stringValue || DEFAULT_SETTINGS.siteName,
      whatsappNumber: fields.whatsappNumber?.stringValue || DEFAULT_SETTINGS.whatsappNumber,
      whatsappMessage: fields.whatsappMessage?.stringValue || DEFAULT_SETTINGS.whatsappMessage,
      primaryColor: fields.primaryColor?.stringValue || DEFAULT_SETTINGS.primaryColor,
      accentColor: fields.accentColor?.stringValue || DEFAULT_SETTINGS.accentColor,
      footerText: fields.footerText?.stringValue || DEFAULT_SETTINGS.footerText,
      heroTitle: fields.heroTitle?.stringValue || DEFAULT_SETTINGS.heroTitle,
      heroSubtitle: fields.heroSubtitle?.stringValue || DEFAULT_SETTINGS.heroSubtitle
    };
  } catch (error) {
    console.error('Error fetching settings:', error);
    return DEFAULT_SETTINGS;
  }
}

async function updateSettings(settings) {
  const fields = {
    siteName: { stringValue: settings.siteName || DEFAULT_SETTINGS.siteName },
    whatsappNumber: { stringValue: settings.whatsappNumber || DEFAULT_SETTINGS.whatsappNumber },
    whatsappMessage: { stringValue: settings.whatsappMessage || DEFAULT_SETTINGS.whatsappMessage },
    primaryColor: { stringValue: settings.primaryColor || DEFAULT_SETTINGS.primaryColor },
    accentColor: { stringValue: settings.accentColor || DEFAULT_SETTINGS.accentColor },
    footerText: { stringValue: settings.footerText || DEFAULT_SETTINGS.footerText },
    heroTitle: { stringValue: settings.heroTitle || DEFAULT_SETTINGS.heroTitle },
    heroSubtitle: { stringValue: settings.heroSubtitle || DEFAULT_SETTINGS.heroSubtitle }
  };

  try {
    const response = await fetch(
      `${FIRESTORE_BASE_URL}/site-settings/main?key=${FIRESTORE_API_KEY}`,
      {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ fields })
      }
    );

    if (!response.ok) {
      throw new Error(`Failed to update: ${response.statusText}`);
    }

    return settings;
  } catch (error) {
    console.error('Error updating settings:', error);
    throw error;
  }
}

exports.handler = async function (event) {
  const method = event.httpMethod;

  try {
    if (method === 'GET') {
      const settings = await getSettings();
      return {
        statusCode: 200,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(settings)
      };
    }

    if (method === 'PUT') {
      const settings = JSON.parse(event.body || '{}');
      const updated = await updateSettings(settings);
      return {
        statusCode: 200,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(updated)
      };
    }

    return {
      statusCode: 400,
      body: JSON.stringify({ error: 'Invalid request' })
    };
